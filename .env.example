# ─────────────────────────────────────────────────────────────────────────────
# Suroskie Creative Performance Portal — environment variables
# Copy to .env (local) or set in your host's secret store. Never commit real values.
# All variables are validated at boot (src/lib/env.ts); the app refuses to start if invalid.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (managed Postgres in production; enable SSL there, e.g. ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/suroskie?schema=public"

# Public base URL of the app, no trailing slash. Used for links, cookies, CSRF origin checks and OAuth redirects.
# Use ONE canonical URL (e.g. your production domain) and always open the portal through it: requests from other
# aliases (Vercel preview URLs) are rejected by the CSRF check, and Facebook Login redirects only to this URL.
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# Session signing secret (≥ 32 chars).            Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# 32 random bytes, base64. Encrypts Meta tokens.  Generate: openssl rand -base64 32
# Losing this key makes stored Meta tokens unreadable (reconnect Meta). Back it up in your secret manager.
TOKEN_ENCRYPTION_KEY=""
# Shared secret for /api/cron/* (≥ 32 chars).     Generate: openssl rand -hex 32
# On Vercel, setting CRON_SECRET makes Vercel Cron send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# ── Meta app (developers.facebook.com → your app → App settings → Basic) ──
# Required for BOTH connection methods (system-user token and Facebook Login): the portal validates every
# token with Meta's debug_token using these, and signs every API call with appsecret_proof.
META_APP_ID=""
META_APP_SECRET=""
# Graph API version. v24.0 matches the current official Node Business SDK; Meta also accepted up to v26.0
# when this was built. Review Meta's changelog before raising it.
META_API_VERSION="v24.0"
# Facebook Login only: add <APP_URL>/api/v1/admin/meta/oauth/callback as a Valid OAuth Redirect URI in the app.
# Optional: "Facebook Login for Business" configuration id (used instead of a scope list in the OAuth dialog)
META_LOGIN_CONFIG_ID=""
# Test-only overrides — leave unset in production.
# META_GRAPH_BASE_URL="https://graph.facebook.com"
# META_OAUTH_BASE_URL="https://www.facebook.com"

# true = reports show ONLY synthetic demo accounts (npm run demo:seed). false = ONLY real Meta data.
# Going live: set false, remove "npm run demo:seed" from the build command, and run "npm run demo:clear" once.
DEMO_MODE="false"

# ── Email (invitations, password resets). Without SMTP, invitation links are shown to the admin instead,
#    and password resets cannot be delivered. ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="Suroskie Portal <no-reply@your-domain.com>"

# Max time a cron/worker invocation spends processing sync jobs (ms).
WORKER_TIME_BUDGET_MS="240000"

# ── First-run bootstrap only (npm run db:seed). Creates the first Super Admin if none exists.
#    Remove from the environment after the first deploy. ──
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Super Admin"
